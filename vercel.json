{
  "rewrites": [
    { "source": "/gestor", "destination": "/gestor.html" },
    { "source": "/painel", "destination": "/painel.html" },
    { "source": "/ajuda", "destination": "/ajuda.html" },
    { "source": "/pedido", "destination": "/pedido.html" },
    { "source": "/:slug/pedido", "destination": "/pedido.html" },
    { "source": "/:slug/entrega", "destination": "/entrega.html" },
    { "source": "/api/manifest-catalogo", "destination": "/api/manifest?tipo=catalogo" },
    { "source": "/api/manifest-entrega", "destination": "/api/manifest?tipo=entrega" },
    { "source": "/api/asaas-cobranca", "destination": "/api/asaas?mode=cobranca" },
    { "source": "/api/asaas-webhook", "destination": "/api/asaas?mode=webhook" },
    { "source": "/api/entrega-lista", "destination": "/api/entrega?acao=listar" },
    { "source": "/api/entrega-confirmar", "destination": "/api/entrega?acao=confirmar" }
  ],
  "crons": [
    { "path": "/api/membros", "schedule": "0 8 * * *" }
  ]
}
